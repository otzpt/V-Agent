<?xml version="1.0" encoding="UTF-8"?>
<!--
  V-Agent Windows installer (WiX v5).

  Per-user install to %LOCALAPPDATA%\Programs\V-Agent — no administrator
  rights required, and it does not touch a separately installed Zed. Build
  with packaging/windows/build-msi.ps1, which stages the binary and its
  runtime DLLs onto an ASCII path first (the repo lives under a path with
  non-ASCII characters, which some Windows build tools mishandle).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="V-Agent"
      Manufacturer="V-Agent"
      Version="1.1.1.0"
      UpgradeCode="83E8D434-55B4-4A23-811D-231EE457B302"
      Scope="perUser"
      InstallerVersion="500"
      Compressed="yes">

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of V-Agent is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VAgentIcon" SourceFile="$(var.StageDir)\v-agent.ico" />
    <Property Id="ARPPRODUCTICON" Value="VAgentIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/otzpt/V-Agent" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/otzpt/V-Agent" />

    <!-- Install root: %LOCALAPPDATA%\Programs\V-Agent -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="V-Agent" />
      </Directory>
    </StandardDirectory>

    <!-- Start Menu folder -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppShortcutFolder" Name="V-Agent" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Payload: the editor plus its terminal and GPU runtime siblings -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe">
        <File Id="VAgentExe" Source="$(var.StageDir)\v-agent.exe" KeyPath="yes" />
      </Component>
      <Component Id="ConptyDll">
        <File Source="$(var.StageDir)\conpty.dll" KeyPath="yes" />
      </Component>
      <Component Id="OpenConsoleExe">
        <File Source="$(var.StageDir)\OpenConsole.exe" KeyPath="yes" />
      </Component>
      <!-- Optional. build-msi.ps1 sets HaveAmdAgs=no when the DLL is not on
           the build machine; without this guard WiX fails with WIX0103 on a
           file the script had already decided to skip. Upstream's Inno Setup
           script treats it the same way (`#ifexist` in zed.iss). -->
      <?if $(var.HaveAmdAgs) = "yes" ?>
      <Component Id="AmdAgsDll">
        <File Source="$(var.StageDir)\amd_ags_x64.dll" KeyPath="yes" />
      </Component>
      <?endif?>
    </ComponentGroup>

    <!-- Start Menu shortcut. Per-user shortcuts key off an HKCU value. -->
    <Component Id="StartMenuShortcut" Directory="AppShortcutFolder"
               Guid="8D1D763C-F7B9-4867-9CC0-30175F7920D6">
      <Shortcut Id="VAgentShortcut"
                Name="V-Agent"
                Description="A native, GPU-accelerated code editor with local-first AI"
                Target="[INSTALLFOLDER]v-agent.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="VAgentIcon" />
      <RemoveFolder Id="RemoveAppShortcutFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\V-Agent"
                     Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder"
               Guid="10B09658-5F34-4D62-A44F-0DF64E59FD4A">
      <Shortcut Id="VAgentDesktopShortcut"
                Name="V-Agent"
                Description="A native, GPU-accelerated code editor with local-first AI"
                Target="[INSTALLFOLDER]v-agent.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="VAgentIcon" />
      <RegistryValue Root="HKCU" Key="Software\V-Agent"
                     Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!--
      Explorer context menus. Opening a project is the normal way to start an
      editor, so without these the only entry points are the Start Menu and
      dragging a folder onto the window.

      %1 passes the clicked file; %V is the folder the menu was opened on,
      which is what the directory and background entries need. Registry layout
      and argument choices mirror upstream's Inno Setup installer
      (crates/zed/resources/windows/zed.iss).

      Deliberately not included: the per-extension file associations that
      installer also writes. They run to hundreds of registry values and would
      claim file types away from the user's existing editor, which is a choice
      the user should make, not the installer.
    -->
    <Component Id="ExplorerContextMenu" Directory="INSTALLFOLDER"
               Guid="FA9DFBE3-4D4E-427E-B531-CD487C7F82D8">
      <RegistryValue Root="HKCU" Key="Software\V-Agent"
                     Name="contextMenu" Type="integer" Value="1" KeyPath="yes" />

      <RegistryKey Root="HKCU" Key="Software\Classes\*\shell\VAgent" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="expandable" Value="Open w&amp;ith V-Agent" />
        <RegistryValue Name="Icon" Type="expandable" Value="[INSTALLFOLDER]v-agent.exe" />
        <RegistryKey Key="command">
          <RegistryValue Type="expandable" Value="&quot;[INSTALLFOLDER]v-agent.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>

      <RegistryKey Root="HKCU" Key="Software\Classes\Directory\shell\VAgent" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="expandable" Value="Open w&amp;ith V-Agent" />
        <RegistryValue Name="Icon" Type="expandable" Value="[INSTALLFOLDER]v-agent.exe" />
        <RegistryKey Key="command">
          <RegistryValue Type="expandable" Value="&quot;[INSTALLFOLDER]v-agent.exe&quot; &quot;%V&quot;" />
        </RegistryKey>
      </RegistryKey>

      <RegistryKey Root="HKCU" Key="Software\Classes\Directory\Background\shell\VAgent" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="expandable" Value="Open w&amp;ith V-Agent" />
        <RegistryValue Name="Icon" Type="expandable" Value="[INSTALLFOLDER]v-agent.exe" />
        <RegistryKey Key="command">
          <RegistryValue Type="expandable" Value="&quot;[INSTALLFOLDER]v-agent.exe&quot; &quot;%V&quot;" />
        </RegistryKey>
      </RegistryKey>

      <RegistryKey Root="HKCU" Key="Software\Classes\Drive\shell\VAgent" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="expandable" Value="Open w&amp;ith V-Agent" />
        <RegistryValue Name="Icon" Type="expandable" Value="[INSTALLFOLDER]v-agent.exe" />
        <RegistryKey Key="command">
          <RegistryValue Type="expandable" Value="&quot;[INSTALLFOLDER]v-agent.exe&quot; &quot;%V&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>

    <!--
      PATH entry, so `v-agent .` works from a terminal. Upstream adds {app}\bin
      because its CLI wrapper lives there; this fork does not build crates/cli
      (release.yml builds the v-agent binary only), so the install root itself
      is what goes on PATH.
    -->
    <Component Id="PathEntry" Directory="INSTALLFOLDER"
               Guid="D7235C1C-8C31-4AB4-87D8-4E5BD089D8AC">
      <Environment Id="VAgentPath" Name="PATH" Value="[INSTALLFOLDER]"
                   Part="last" Action="set" System="no" Permanent="no" />
      <RegistryValue Root="HKCU" Key="Software\V-Agent"
                     Name="pathEntry" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="V-Agent" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="ExplorerContextMenu" />
      <ComponentRef Id="PathEntry" />
    </Feature>
  </Package>
</Wix>
